<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The real colours come from the Compose theme; this exists only so the window has sensible
      background and status-bar handling before the first frame is drawn.
    -->
    <style name="Theme.Assistant" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
